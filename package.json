{
  "name": "dsh-wait-buddy",
  "version": "0.7.0",
  "description": "WaitBuddy: a DSH session view that monitors long-running Agent tasks, with approval/failure alerts and lightweight games.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-view",
    "monitor",
    "snake",
    "gomoku"
  ],
  "author": "dzhuang",
  "scripts": {
    "test": "node --test",
    "test:meta": "node tools/check-version.mjs",
    "test:visual": "node tools/visual-layout.mjs",
    "test:all": "npm run test:meta && npm test && npm run test:visual"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
